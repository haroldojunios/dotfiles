Host *
  UpdateHostKeys yes
  StrictHostKeyChecking accept-new

Host android
  Port 2222

Host termux
  Port 8022

Match host android,termux exec "nc -w 1 -z 192.168.0.22 %p"
  HostName 192.168.0.22
Match host android,termux exec "nc -w 1 -z 192.168.1.22 %p"
  HostName 192.168.1.22
# tailscale
Match host android,termux exec "nc -w 1 -z 100.115.199.96 %p"
  HostName 100.115.199.96
# zerotier
Match host android,termux exec "nc -w 1 -z 172.23.181.8 %p"
  HostName 172.23.181.8
Match host android,termux exec "nc -w 1 -z 192.168.100.122 %p"
  HostName 192.168.100.122
Match host android,termux exec "nc -w 1 -z 10.0.0.22 %p"
  HostName 10.0.0.22

Host rasp
  User haroldo

Match host rasp exec "nc -w 1 -z 192.168.0.161 %p"
  Hostname 192.168.0.161
# tailscale
Match host rasp exec "nc -w 1 -z 100.86.42.20 %p"
  Hostname 100.86.42.20
# zerotier
Match host rasp exec "nc -w 1 -z 172.23.96.154 %p"
  Hostname 172.23.96.154

Host pc
  User haroldo

Match host pc exec "nc -w 1 -z 192.168.0.20 %p"
  HostName 192.168.0.20
Match host pc exec "nc -w 1 -z 192.168.0.21 %p"
  HostName 192.168.0.21
# tailscale
Match host pc exec "nc -w 1 -z 100.105.190.69 %p"
  HostName 100.105.190.69
# zerotier
Match host pc exec "nc -w 1 -z 172.23.66.144 %p"
  HostName 172.23.66.144
